{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build extension",
            "type": "process",
            "command": "${workspaceFolder}/cli/bin/run",
            "args": [
                "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$ts-webpack"
            ]
        },
        {
            "label": "Verify extension",
            "type": "process",
            "command": "${workspaceFolder}/cli/bin/run",
            "args": [
                "verify"
            ],
            "group": "test",
            "problemMatcher": []
        }
    ]
}
